type tie<logic>
// term 探针：非 TTY 环境下验证 API 面与降级判据（真实交互由 harness 驱动）。
import "../src/core/term.tie"
var g_pass: i64 = 0
var g_fail: i64 = 0
func check(cond: bool, tag: string) {
    if cond { g_pass = g_pass + 1; println("PASS " + tag) }
    else { g_fail = g_fail + 1; println("FAIL " + tag) }
}
func main() {
    // 管道下：tty_ok 判假（降级路径）；vt_on/raw_on 容错不崩
    check(!term.tty_ok(), "1.1 管道下 tty_ok=false（降级判据）")
    var v = term.vt_on()
    // POSIX vt_on 为无操作恒真（无控制台句柄可置的场景仅 Windows）；
    // Windows 管道下无句柄 ⇒ false。
    if get_env("OS") == "Windows_NT" {
        check(!v, "1.2 管道下 vt_on=false（无控制台句柄可置）")
    } else {
        check(v, "1.2 posix vt_on 恒真（无操作）")
    }
    var r = term.raw_on()
    check(!r, "1.3 管道下 raw_on=false")
    term.raw_off()
    var c = term.term_cols()
    check(c >= 1, "1.4 term_cols 兜底有效: " + to_string(c))
    println("SUMMARY PASS=" + to_string(g_pass) + " FAIL=" + to_string(g_fail))
    if g_fail > 0 { exit(1) }
}
